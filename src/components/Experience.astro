---
import ExperienceItem from "./ExperienceItem.astro";
import { getLangFromUrl } from "../i18n/utils";
import { experience } from "../i18n/content";

const lang = getLangFromUrl(Astro.url);

// Lo que no se traduce. Las tecnologias van como texto plano y no como claves
// del registro: aqui hay que poder nombrar cosas que no forman parte del stack
// declarado, como Versat ERP o GeneXus.
// ELBRUX no lleva enlace: sus productos viven en subdominios propios y no hay
// una web corporativa publica todavia.
const META = [
  {
    link: "",
    logo: "/elbrux.webp",
    logoDark: "/elbrux-dark.webp",
    actual: true,
    accent: "blue" as const,
    tags: ["Python", "FastAPI", "PostgreSQL", "React", "Docker", "Scrum"],
  },
  {
    link: "https://biosafrasgroup.com.py/",
    logo: "/biosafras.webp",
    actual: false,
    accent: "emerald" as const,
    tags: [
      "Java",
      "Spring Boot",
      "React",
      "Python",
      "MySQL",
      "Docker",
      "Versat ERP",
      "n8n",
      "Power BI",
    ],
  },
  {
    link: "https://www.ayacape.coop.py/v3/",
    logo: "/ayacape.webp",
    actual: false,
    accent: "rose" as const,
    tags: ["GeneXus", "Java", "Oracle SQL", "XML", "Postman"],
  },
];

const EXPERIENCE = experience[lang].map((entry, i) => ({ ...entry, ...META[i] }));
---

<ol class="mt-10 space-y-6">
  {
    EXPERIENCE.map((entry) => (
      <li>
        <ExperienceItem {...entry} />
      </li>
    ))
  }
</ol>
