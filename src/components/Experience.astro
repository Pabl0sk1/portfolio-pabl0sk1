---
import ExperienceItem from "./ExperienceItem.astro";
import SeedIcon from "./icons/Seed.astro";
import BankIcon from "./icons/Bank.astro";

const EXPERIENCE = [
  {
    date: "Mayo 2025 - Actualmente",
    title: "Desarrollador web",
    company: "Biosafras Group",
    description: [
      "Responsable del desarrollo e implementación de soluciones empresariales internas, incluyendo un sistema tipo ERP construido desde cero para la gestión operativa de la empresa.",
      "Diseño y desarrollo de backend con Java y Spring Boot, exponiendo APIs REST para consumo interno y externo.",
      "Desarrollo de interfaces en React orientadas a la gestión administrativa y operativa.",
      "Integración con sistemas empresariales como Versat ERP, incluyendo análisis de procesos contables y administrativos, así como automatización de flujos mediante n8n.",
      "Desarrollo de scripts en Python para procesamiento, sincronización y respaldo de datos, mejorando la disponibilidad y consistencia de la información.",
      "Creación de dashboards en Power BI para análisis de facturación y soporte en la toma de decisiones.",
      "Soporte técnico e integración de soluciones en múltiples sucursales, participando activamente en la evolución tecnológica de la empresa.",
    ],
    link: "https://biosafrasgroup.com.py/",
    icon: SeedIcon,
    logo: "./biosafras.png",
  },
  {
    date: "Noviembre 2023 - Agosto 2024",
    title: "Desarrollador de software",
    company: "Coop. Ayacapé",
    description: [
      "Desarrollo de soluciones de software utilizando GeneXus y Oracle SQL, participando en sistemas críticos para la operación financiera de la cooperativa.",
      "Desarrollé aplicaciones internas que optimizaron procesos administrativos y de gestión de datos, mejorando la eficiencia operativa en un 20%.",
      "Colaboré con el equipo de TI para integrar nuevos módulos a los sistemas existentes, asegurando la alineación con los objetivos estratégicos de la organización.",
      "Realicé la implementación de control de operaciones basado en listas de sancionados ONU/OFAC, automatizando la verificación de socios en tiempo real.",
      "Desarrollé procesos de carga automática de datos XML a la base de datos y sistemas de alerta y actualización de listas para fortalecer la gestión de riesgos y cumplimiento.",
    ],
    link: "https://www.ayacape.coop.py/v3/",
    icon: BankIcon,
    logo: "./ayacape.png",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
