---
/**
 * Cuerpo de la portada, compartido por la version espanola (/) y la
 * inglesa (/en/). Los textos salen del idioma que detecta cada componente
 * a partir de la URL, asi que no hace falta duplicar el marcado.
 */
import Container from "./Container.astro";
import BriefCaseIcon from "./icons/Briefcase.astro";
import CodeIcon from "./icons/Code.astro";
import TechFlowIcon from "./icons/TechFlow.astro";
import UserIcon from "./icons/User.astro";
import ContactIcon from "./icons/Contact.astro";
import Experience from "./Experience.astro";
import Projects from "./Projects.astro";
import Stack from "./Stack.astro";
import AboutMe from "./AboutMe.astro";
import Hero from "./Hero.astro";
import TitleSection from "./TitleSection.astro";
import SendToMe from "./SendToMe.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main class="px-4">
  {/* relative: la red del hero se posiciona contra esta seccion, para cubrir
      tambien su relleno vertical. Sin overflow-hidden, que recortaria el
      lienzo a sangre; de eso ya se encarga #scroll-area */}
  <Container class="relative py-16 md:py-36">
    <Hero />
  </Container>
  <div class="space-y-24">
    <Container id="experiencia">
      <TitleSection index="01" icon={BriefCaseIcon} accent="blue">
        {t("section.experience")}
      </TitleSection>
      <Experience />
    </Container>

    <Container id="proyectos">
      <TitleSection index="02" icon={CodeIcon} accent="violet">
        {t("section.projects")}
      </TitleSection>
      <Projects />
    </Container>

    <Container id="stack">
      <TitleSection index="03" icon={TechFlowIcon} accent="emerald">
        {t("section.stack")}
      </TitleSection>
      <Stack />
    </Container>

    <Container id="sobre-mi">
      <TitleSection index="04" icon={UserIcon} accent="amber">
        {t("section.about")}
      </TitleSection>
      <AboutMe />
    </Container>

    <Container id="contactar">
      <TitleSection index="05" icon={ContactIcon} accent="rose">
        {t("section.contact")}
      </TitleSection>
      <SendToMe />
    </Container>
  </div>
</main>
