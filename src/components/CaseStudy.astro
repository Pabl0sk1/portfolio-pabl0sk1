---
/**
 * Plantilla de caso de estudio. Sirve para cualquier proyecto: el contenido
 * viene de i18n/casestudy.ts, asi que sumar Timon es una entrada y una ruta.
 */
import TechIcon from "./TechIcon.astro";
import FaroDiagram from "./FaroDiagram.astro";
import { TECH, TAG_COLOR } from "../data/tech";
import { localizePath } from "../i18n/utils";
import type { CaseStudy } from "../i18n/casestudy";
import type { Lang } from "../i18n/ui";

interface Props {
  caso: CaseStudy;
  lang: Lang;
}

const { caso, lang } = Astro.props;
---

<main class="px-4 pb-24">
  <article class="w-full mx-auto container lg:max-w-4xl">
    <!-- Encabezado -->
    <header class="pt-16 md:pt-24">
      <a
        href={localizePath("/", lang)}
        class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-700 dark:hover:text-blue-300 transition"
      >
        <span aria-hidden="true">&larr;</span>
        {caso.volver}
      </a>

      <h1
        class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white"
      >
        {caso.titulo}
      </h1>
      <p class="mt-3 text-lg md:text-xl text-gray-700 dark:text-gray-300 text-balance">
        {caso.subtitulo}
      </p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          [
            [caso.etiquetaRol, caso.rol],
            [caso.etiquetaPeriodo, caso.periodo],
            [caso.etiquetaEstado, caso.estado],
          ].map(([etiqueta, valor]) => (
            <div class="rounded-xl bg-black/5 dark:bg-white/5 ring-1 ring-black/10 dark:ring-white/10 px-4 py-3">
              <dt class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                {etiqueta}
              </dt>
              <dd class="mt-1 text-sm font-medium text-gray-900 dark:text-gray-100">
                {valor}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-6 flex flex-wrap gap-2">
        {
          caso.tags.map((key) => (
            <span
              class={`flex items-center gap-1.5 px-3 py-1.5 text-xs md:text-sm font-medium rounded-full bg-black/85 dark:bg-white ${TAG_COLOR[key] ?? ""}`}
            >
              <TechIcon tech={key} class="w-4 h-4" />
              {TECH[key].label}
            </span>
          ))
        }
      </div>
    </header>

    <!-- El problema -->
    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
        {caso.problemaTitulo}
      </h2>
      <div class="mt-4 space-y-4 text-gray-700 dark:text-gray-300 text-pretty">
        {caso.problema.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- Arquitectura -->
    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
        {caso.arquitecturaTitulo}
      </h2>
      <p class="mt-4 text-gray-700 dark:text-gray-300 text-pretty">
        {caso.arquitecturaIntro}
      </p>
      {caso.slug === "faro" && <FaroDiagram lang={lang} />}
    </section>

    <!-- Decisiones: el corazon del caso de estudio -->
    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
        {caso.decisionesTitulo}
      </h2>
      <p class="mt-4 text-gray-700 dark:text-gray-300 text-pretty">
        {caso.decisionesIntro}
      </p>

      <ol class="mt-8 space-y-6">
        {
          caso.decisiones.map((d, i) => (
            <li class="relative rounded-xl ring-1 ring-black/10 dark:ring-white/10 bg-black/[0.03] dark:bg-white/[0.03] p-5 md:p-6">
              <div class="flex items-start gap-4">
                <span
                  class="shrink-0 grid place-items-center size-8 rounded-full bg-blue-600 text-white text-sm font-bold"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white text-pretty">
                    {d.titulo}
                  </h3>

                  <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                    <span class="font-semibold uppercase tracking-wide text-[11px] text-amber-700 dark:text-amber-400">
                      {caso.etiquetaAlternativa}
                    </span>
                    <br />
                    <span class="line-through decoration-amber-600/50">
                      {d.alternativa}
                    </span>
                  </p>

                  <p class="mt-3 text-gray-700 dark:text-gray-300 text-pretty">
                    <span class="font-semibold uppercase tracking-wide text-[11px] text-emerald-700 dark:text-emerald-400 block">
                      {caso.etiquetaPorque}
                    </span>
                    {d.porque}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Resultados -->
    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
        {caso.resultadosTitulo}
      </h2>
      <ul
        class="mt-4 space-y-3 list-disc pl-5 marker:text-blue-500 text-gray-700 dark:text-gray-300"
      >
        {caso.resultados.map((r) => <li class="text-pretty">{r}</li>)}
      </ul>
    </section>

    <!-- Cierre -->
    <section
      class="mt-16 rounded-xl bg-blue-500/10 ring-1 ring-blue-500/25 p-6 md:p-8"
    >
      <h2 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">
        {caso.cierreTitulo}
      </h2>
      <p class="mt-3 text-gray-700 dark:text-gray-300 text-pretty">
        {caso.cierre}
      </p>
    </section>

    <div class="mt-12">
      <a
        href={localizePath("/", lang)}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-500 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      >
        <span aria-hidden="true">&larr;</span>
        {caso.volver}
      </a>
    </div>
  </article>
</main>
