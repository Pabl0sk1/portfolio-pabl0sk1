---
/**
 * Hero. La red de nodos ya no vive en una tarjeta a la derecha: ocupa el fondo
 * de la seccion entera y sus nodos grandes llevan el nombre del stack.
 *
 * El texto era un titulo mas tres lineas en naranja, azul y rojo. Ahora hay una
 * sola jerarquia: nombre, oficio, un parrafo y dos llamadas a la accion.
 */
import { Image } from "astro:assets";
import avatar from "../assets/pablo.jpg";
import LinkedinIcon from "./icons/LinkedIn.astro";
import GmailIcon from "./icons/Gmail.astro";
import GithubIcon from "./icons/GitHub.astro";
import DiscordIcon from "./icons/Discord.astro";
import SocialPill from "./SocialPill.astro";
import HeroCanvas from "./HeroCanvas.astro";
import {
  LINKEDIN_URL,
  GITHUB_URL,
  DISCORD_URL,
  EMAIL,
  DISPLAY_NAME,
} from "../consts";
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// los nodos con nombre son el stack principal; cinco caben sin amontonarse
const TECHS = ["Python", "FastAPI", "React", "PostgreSQL", "Docker"];
---

<HeroCanvas
  label={`${t("hero.canvas.alt")}: ${TECHS.join(", ")}`}
  techs={TECHS}
/>

<div id="hero-content" class="relative z-10 max-w-2xl">
  <div class="flex items-center gap-4">
    {/*
      La foto vive en el repo y no se pide a avatars.githubusercontent.com:
      llegaba a 400 px para mostrarse a 80 y costaba una conexion a un tercero
      justo en lo primero que se pinta. Con <Image> sale en webp y al tamano
      exacto, con su variante para pantallas de doble densidad.
      A cambio deja de seguir sola a la de GitHub: si cambia el perfil, hay que
      reemplazar src/assets/pablo.jpg.
      Origen: https://avatars.githubusercontent.com/u/127477502?s=400&v=4
    */}
    <Image
      class="rounded-full shadow-lg size-20 object-cover ring-2 ring-white/80 dark:ring-white/20 transition hover:scale-105"
      src={avatar}
      alt={t("hero.imageAlt")}
      width={80}
      height={80}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
    />

    <a
      href={LINKEDIN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 ring-1 ring-emerald-500/30 px-3 py-1.5 text-sm font-semibold text-emerald-700 dark:text-emerald-300 transition hover:bg-emerald-500/20"
    >
      <span class="relative flex size-2" aria-hidden="true">
        <span
          class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
      </span>
      {t("hero.badge")}
    </a>
  </div>

  <h1
    class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight text-balance text-gray-900 dark:text-white"
  >
    {DISPLAY_NAME}
  </h1>

  <p
    class="mt-3 text-lg sm:text-xl font-semibold text-blue-700 dark:text-blue-300 text-balance"
  >
    {t("hero.role")}
  </p>

  <p class="mt-5 text-lg text-gray-700 dark:text-gray-300 text-pretty">
    {t("hero.p1")} {t("hero.p2")}
  </p>

  <p
    class="mt-3 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400"
  >
    <svg
      class="size-4 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </svg>
    {t("hero.p3")}
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href={`${localizePath("/", lang)}#proyectos`}
      class="rounded-lg bg-blue-600 px-5 py-2.5 font-semibold text-white transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      {t("hero.ctaProjects")}
    </a>
    <a
      href={`${localizePath("/", lang)}#contactar`}
      class="rounded-lg bg-black/5 dark:bg-white/10 ring-1 ring-black/10 dark:ring-white/15 px-5 py-2.5 font-semibold text-gray-900 dark:text-white transition hover:bg-black/10 dark:hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      {t("hero.ctaContact")}
    </a>
  </div>

  <nav aria-label={t("hero.social")} class="mt-8 flex flex-wrap gap-4 gap-x-10">
    <SocialPill href={LINKEDIN_URL}>
      <LinkedinIcon class="size-4 md:size-6" />
      LinkedIn
    </SocialPill>
    <SocialPill href={GITHUB_URL}>
      <GithubIcon class="size-4 md:size-6" />
      GitHub
    </SocialPill>
    <SocialPill href={DISCORD_URL}>
      <DiscordIcon class="size-4 md:size-6" />
      Discord
    </SocialPill>
    <SocialPill href={`mailto:${EMAIL}`}>
      <GmailIcon class="size-4 md:size-6" />
      Gmail
    </SocialPill>
  </nav>
</div>
