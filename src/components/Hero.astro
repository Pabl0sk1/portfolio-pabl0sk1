---
import Badge from "./Badge.astro";
import LinkedinIcon from "./icons/LinkedIn.astro";
import GmailIcon from "./icons/Gmail.astro";
import GithubIcon from "./icons/GitHub.astro";
import DiscordIcon from "./icons/Discord.astro";
import SocialPill from "./SocialPill.astro";
import {
  LINKEDIN_URL,
  GITHUB_URL,
  DISCORD_URL,
  EMAIL,
  GITHUB_AVATAR,
} from "../consts";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="flex flex-col md:flex-row items-center md:items-start gap-8 max-w-6xl mx-auto mt-12 px-4"
>
  <!-- IZQUIERDA: Texto e info -->
  <div class="flex-1 max-w-xl">
    <div class="flex gap-4 mb-4">
      <img
        class="rounded-full shadow-lg w-20 h-20 object-cover transition hover:scale-105 border border-white hover:border-blue-800"
        src={GITHUB_AVATAR}
        alt={t("hero.imageAlt")}
        width="80"
        height="80"
        fetchpriority="high"
        decoding="async"
      />
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center transition md:justify-center md:hover:scale-105"
      >
        <Badge>{t("hero.badge")}</Badge>
      </a>
    </div>
    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
      {t("hero.greeting")}
    </h1>
    <h2 class="mt-2 text-lg text-blue-700 dark:text-blue-200 font-normal">
      {t("hero.role")}
    </h2>
    <p
      class="mt-6 text-balance text-xl flex flex-col gap-2 text-gray-800 dark:text-gray-300"
    >
      <span class="text-orange-600 dark:text-yellow-200/85"
        >{t("hero.p1")}</span
      >
      <span class="text-blue-700 dark:text-blue-200/85 font-semibold"
        >{t("hero.p2")}</span
      >
      <span class="text-red-600 dark:text-red-300/85"
        >{t("hero.p3")}</span
      >
    </p>
    <nav
      aria-label={t("hero.social")}
      class="flex flex-wrap gap-4 gap-x-10 mt-8"
    >
      <SocialPill href={LINKEDIN_URL}>
        <LinkedinIcon class="size-4 md:size-6" />
        LinkedIn
      </SocialPill>
      <SocialPill href={GITHUB_URL}>
        <GithubIcon class="size-4 md:size-6" />
        GitHub
      </SocialPill>
      <SocialPill href={DISCORD_URL}>
        <DiscordIcon class="size-4 md:size-6" />
        Discord
      </SocialPill>
      <SocialPill href={`mailto:${EMAIL}`}>
        <GmailIcon class="size-4 md:size-6" />
        Gmail
      </SocialPill>
    </nav>
  </div>

  <!-- Modelo 3D: se carga solo al entrar en pantalla, con esqueleto mientras tanto -->
  <div class="flex-1 w-full md:w-auto">
    <div
      id="model-slot"
      data-alt={t("hero.model.alt")}
      data-error={t("hero.model.error")}
      class="relative w-full md:w-auto h-80 md:h-[500px] rounded-2xl overflow-hidden bg-black/10 dark:bg-white/10"
    >
      <div
        id="model-placeholder"
        class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-gray-600 dark:text-gray-400 motion-safe:animate-pulse"
      >
        <svg
          class="size-10 opacity-60"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 7.5 12 2.25 3 7.5m18 0-9 5.25m9-5.25v9L12 21m0-8.25L3 7.5m9 5.25V21M3 7.5v9L12 21"
          ></path>
        </svg>
        <span class="text-sm">{t("hero.model.loading")}</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Carga diferida: el visor 3D (~300 KB) y el modelo (~1.5 MB) solo se descargan
  // cuando el contenedor entra en pantalla, para no competir con el LCP del Hero.
  const slot = document.getElementById("model-slot");
  const placeholder = document.getElementById("model-placeholder");

  if (slot) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const loadViewer = async () => {
      try {
        const { ModelViewerElement } = await import("@google/model-viewer");

        // El modelo va comprimido con Draco, asi que hace falta su decoder.
        // Por defecto model-viewer lo baja de gstatic.com; lo servimos nosotros
        // para no depender de un tercero. Ojo: debe ir ANTES de crear el visor.
        ModelViewerElement.dracoDecoderLocation = "/draco/";

        const viewer = document.createElement("model-viewer");
        viewer.setAttribute("src", "/models/desktop.glb");
        viewer.setAttribute("alt", slot.dataset.alt ?? "");
        viewer.setAttribute("camera-controls", "");
        viewer.setAttribute("touch-action", "pan-y");
        viewer.setAttribute("camera-orbit", "45deg 75deg 3m");
        viewer.setAttribute("camera-target", "0m 0m 0m");
        viewer.setAttribute("shadow-intensity", "1");
        viewer.setAttribute("interaction-prompt", "none");
        // respeta a quien pidio menos movimiento en su sistema
        if (!prefersReducedMotion) viewer.setAttribute("auto-rotate", "");
        viewer.className = "w-full h-full block";

        viewer.addEventListener("load", () => placeholder?.remove(), {
          once: true,
        });

        slot.appendChild(viewer);
      } catch {
        if (placeholder) {
          placeholder.classList.remove("motion-safe:animate-pulse");
          placeholder.textContent = slot.dataset.error ?? "";
        }
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          loadViewer();
        }
      },
      { rootMargin: "200px" },
    );

    observer.observe(slot);
  }
</script>
