---
import Badge from "./Badge.astro";
import LinkedinIcon from "./icons/LinkedIn.astro";
import GmailIcon from "./icons/Gmail.astro";
import GithubIcon from "./icons/GitHub.astro";
import DiscordIcon from "./icons/Discord.astro";
import SocialPill from "./SocialPill.astro";
import HeroCanvas from "./HeroCanvas.astro";
import {
  LINKEDIN_URL,
  GITHUB_URL,
  DISCORD_URL,
  EMAIL,
  GITHUB_AVATAR,
} from "../consts";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="flex flex-col md:flex-row items-center md:items-start gap-8 max-w-6xl mx-auto mt-12 px-4"
>
  <!-- IZQUIERDA: Texto e info -->
  <div class="flex-1 max-w-xl">
    <div class="flex gap-4 mb-4">
      <img
        class="rounded-full shadow-lg w-20 h-20 object-cover transition hover:scale-105 border border-white hover:border-blue-800"
        src={GITHUB_AVATAR}
        alt={t("hero.imageAlt")}
        width="80"
        height="80"
        fetchpriority="high"
        decoding="async"
      />
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center transition md:justify-center md:hover:scale-105"
      >
        <Badge>{t("hero.badge")}</Badge>
      </a>
    </div>
    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
      {t("hero.greeting")}
    </h1>
    <h2 class="mt-2 text-lg text-blue-700 dark:text-blue-200 font-normal">
      {t("hero.role")}
    </h2>
    <p
      class="mt-6 text-balance text-xl flex flex-col gap-2 text-gray-800 dark:text-gray-300"
    >
      <span class="text-orange-600 dark:text-yellow-200/85"
        >{t("hero.p1")}</span
      >
      <span class="text-blue-700 dark:text-blue-200/85 font-semibold"
        >{t("hero.p2")}</span
      >
      <span class="text-red-600 dark:text-red-300/85"
        >{t("hero.p3")}</span
      >
    </p>
    <nav
      aria-label={t("hero.social")}
      class="flex flex-wrap gap-4 gap-x-10 mt-8"
    >
      <SocialPill href={LINKEDIN_URL}>
        <LinkedinIcon class="size-4 md:size-6" />
        LinkedIn
      </SocialPill>
      <SocialPill href={GITHUB_URL}>
        <GithubIcon class="size-4 md:size-6" />
        GitHub
      </SocialPill>
      <SocialPill href={DISCORD_URL}>
        <DiscordIcon class="size-4 md:size-6" />
        Discord
      </SocialPill>
      <SocialPill href={`mailto:${EMAIL}`}>
        <GmailIcon class="size-4 md:size-6" />
        Gmail
      </SocialPill>
    </nav>
  </div>

  <!-- Red de nodos dibujada a mano sobre canvas -->
  <div class="flex-1 w-full md:w-auto">
    <HeroCanvas label={t("hero.canvas.alt")} />
  </div>
</div>

