---
/**
 * Red de nodos con peticiones viajando por las aristas.
 * Dibujado a mano sobre canvas, sin librerias: sustituye al modelo 3D, que
 * era un recurso descargado y no demostraba nada del trabajo propio.
 *
 * Se pausa fuera de pantalla y con la pestana oculta, y se queda quieto si el
 * sistema pide menos movimiento.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  id="hero-canvas-wrap"
  class="relative w-full md:w-auto h-80 md:h-[500px] rounded-2xl overflow-hidden bg-gradient-to-br from-blue-500/5 to-indigo-500/10 dark:from-blue-400/5 dark:to-indigo-400/10 ring-1 ring-black/5 dark:ring-white/10"
>
  <canvas
    id="hero-canvas"
    role="img"
    aria-label={label}
    class="block w-full h-full"></canvas>
</div>

<script>
  const wrap = document.getElementById("hero-canvas-wrap");
  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");

  if (wrap && canvas && ctx) {
    const menosMovimiento = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    type Nodo = {
      x: number; y: number;      // posicion base, en fraccion del lienzo
      vx: number; vy: number;    // deriva lenta
      r: number;                 // radio
      hub: boolean;              // los hub son los nodos grandes
    };
    type Arista = { a: number; b: number };
    type Pulso = { arista: number; t: number; v: number };

    let ancho = 0;
    let alto = 0;
    let nodos: Nodo[] = [];
    let aristas: Arista[] = [];
    let pulsos: Pulso[] = [];
    const raton = { x: -999, y: -999, activo: false };

    const CANT_NODOS = 26;
    const DIST_ARISTA = 0.28; // en fraccion del lado menor

    const aleatorio = (min: number, max: number) =>
      min + Math.random() * (max - min);

    const construir = () => {
      // Rejilla con jitter en vez de posiciones al azar: al azar salen grumos
      // y zonas vacias, y esto tiene que leerse como una red, no como ruido.
      const cols = 6;
      const filas = 5;
      const celdas: { cx: number; cy: number }[] = [];
      for (let f = 0; f < filas; f++) {
        for (let c = 0; c < cols; c++) {
          celdas.push({ cx: (c + 0.5) / cols, cy: (f + 0.5) / filas });
        }
      }
      // barajar para que los hub no caigan siempre en las mismas celdas
      for (let i = celdas.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [celdas[i], celdas[j]] = [celdas[j], celdas[i]];
      }

      const jitterX = 0.5 / cols;
      const jitterY = 0.5 / filas;

      nodos = celdas.slice(0, CANT_NODOS).map((celda, i) => {
        const hub = i < 4;
        return {
          x: Math.min(0.94, Math.max(0.06, celda.cx + aleatorio(-jitterX, jitterX))),
          y: Math.min(0.94, Math.max(0.06, celda.cy + aleatorio(-jitterY, jitterY))),
          vx: aleatorio(-0.00007, 0.00007),
          vy: aleatorio(-0.00007, 0.00007),
          r: hub ? aleatorio(4.5, 6) : aleatorio(1.8, 3),
          hub,
        };
      });

      aristas = [];
      for (let i = 0; i < nodos.length; i++) {
        for (let j = i + 1; j < nodos.length; j++) {
          const dx = nodos[i].x - nodos[j].x;
          const dy = nodos[i].y - nodos[j].y;
          if (Math.hypot(dx, dy) < DIST_ARISTA) aristas.push({ a: i, b: j });
        }
      }

      // una peticion viajando por algunas aristas, no por todas
      pulsos = [];
      aristas.forEach((_, i) => {
        if (Math.random() < 0.45) {
          pulsos.push({ arista: i, t: Math.random(), v: aleatorio(0.0022, 0.005) });
        }
      });
    };

    const redimensionar = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const caja = wrap.getBoundingClientRect();
      ancho = caja.width;
      alto = caja.height;
      canvas.width = Math.round(ancho * dpr);
      canvas.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const esOscuro = () => document.documentElement.classList.contains("dark");

    const pintar = () => {
      const oscuro = esOscuro();
      const colNodo = oscuro ? "148, 197, 253" : "37, 99, 235";
      const colHub = oscuro ? "129, 140, 248" : "79, 70, 229";
      const colArista = oscuro ? "148, 163, 184" : "71, 85, 105";

      ctx.clearRect(0, 0, ancho, alto);
      const lado = Math.min(ancho, alto);

      const px = (n: Nodo) => n.x * ancho;
      const py = (n: Nodo) => n.y * alto;

      // aristas
      ctx.lineWidth = 1;
      for (const e of aristas) {
        const a = nodos[e.a];
        const b = nodos[e.b];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        const alpha = (1 - d / DIST_ARISTA) * (oscuro ? 0.34 : 0.28);
        ctx.strokeStyle = `rgba(${colArista}, ${Math.max(0, alpha)})`;
        ctx.beginPath();
        ctx.moveTo(px(a), py(a));
        ctx.lineTo(px(b), py(b));
        ctx.stroke();
      }

      // peticiones viajando
      for (const p of pulsos) {
        const e = aristas[p.arista];
        if (!e) continue;
        const a = nodos[e.a];
        const b = nodos[e.b];
        const x = px(a) + (px(b) - px(a)) * p.t;
        const y = py(a) + (py(b) - py(a)) * p.t;

        const halo = ctx.createRadialGradient(x, y, 0, x, y, 7);
        halo.addColorStop(0, `rgba(${colNodo}, ${oscuro ? 0.9 : 0.75})`);
        halo.addColorStop(1, `rgba(${colNodo}, 0)`);
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(x, y, 7, 0, Math.PI * 2);
        ctx.fill();
      }

      // nodos
      for (const n of nodos) {
        const x = px(n);
        const y = py(n);
        ctx.fillStyle = `rgba(${n.hub ? colHub : colNodo}, ${n.hub ? 0.95 : 0.7})`;
        ctx.beginPath();
        ctx.arc(x, y, n.r, 0, Math.PI * 2);
        ctx.fill();

        if (n.hub) {
          ctx.strokeStyle = `rgba(${colHub}, 0.35)`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(x, y, n.r + 5, 0, Math.PI * 2);
          ctx.stroke();
        }
      }

      // el cursor separa suavemente los nodos cercanos
      if (raton.activo) {
        for (const n of nodos) {
          const dx = px(n) - raton.x;
          const dy = py(n) - raton.y;
          const d = Math.hypot(dx, dy);
          if (d < 110 && d > 0.5) {
            const empuje = ((110 - d) / 110) * 0.0009;
            n.x += (dx / d) * empuje;
            n.y += (dy / d) * empuje;
          }
        }
      }

      void lado;
    };

    const avanzar = () => {
      for (const n of nodos) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0.05 || n.x > 0.95) n.vx *= -1;
        if (n.y < 0.05 || n.y > 0.95) n.vy *= -1;
      }
      for (const p of pulsos) {
        p.t += p.v;
        if (p.t > 1) {
          p.t = 0;
          p.v = aleatorio(0.0022, 0.005);
        }
      }
    };

    let raf = 0;
    let corriendo = false;

    const bucle = () => {
      avanzar();
      pintar();
      raf = requestAnimationFrame(bucle);
    };

    const arrancar = () => {
      if (corriendo || menosMovimiento) return;
      corriendo = true;
      raf = requestAnimationFrame(bucle);
    };

    const parar = () => {
      corriendo = false;
      cancelAnimationFrame(raf);
    };

    construir();
    redimensionar();
    pintar();

    if (menosMovimiento) {
      // se deja el fotograma fijo: la red se ve, pero nada se mueve
    } else {
      // solo animar cuando esta en pantalla y la pestana visible
      const io = new IntersectionObserver(
        (entradas) => (entradas[0].isIntersecting ? arrancar() : parar()),
        { threshold: 0.05 }
      );
      io.observe(wrap);

      document.addEventListener("visibilitychange", () =>
        document.hidden ? parar() : arrancar()
      );
    }

    const alRedimensionar = () => {
      redimensionar();
      pintar();
    };
    window.addEventListener("resize", alRedimensionar, { passive: true });

    wrap.addEventListener("pointermove", (e) => {
      const caja = wrap.getBoundingClientRect();
      raton.x = e.clientX - caja.left;
      raton.y = e.clientY - caja.top;
      raton.activo = true;
    });
    wrap.addEventListener("pointerleave", () => (raton.activo = false));
  }
</script>
