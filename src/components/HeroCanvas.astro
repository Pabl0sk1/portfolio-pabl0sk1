---
/**
 * Red de nodos con peticiones viajando por las aristas, dibujada a mano sobre
 * canvas y sin librerias.
 *
 * Ocupa el fondo del hero de lado a lado en vez de vivir en una tarjeta a la
 * derecha, y sus nodos grandes son el stack principal, cada uno con el logo de
 * su tecnologia: asi la animacion dice algo en vez de ser adorno.
 *
 * Los logos no se pintan en el lienzo: son los mismos componentes SVG del
 * resto del sitio, colocados encima y movidos con transform en cada frame.
 * Rasterizarlos perdia los degradados (Python) y el color por tema, y a 20 px
 * un SVG real se ve nitido en cualquier densidad de pantalla.
 *
 * Con sitio a la derecha del texto, los logos van en zigzag por esa banda. Sin
 * sitio (movil y anchos intermedios) el texto ocupa todo el ancho, asi que se
 * reparten por el fondo entero del hero, detras del texto y atenuados, igual
 * que la red. Se probo una fila al pie para no pisar el texto y quedaba como
 * una barra pegada, no como parte de la red. El modo lo decide el script
 * midiendo, y lo publica en data-layout para que el CSS elija la mascara.
 *
 * Se pausa fuera de pantalla y con la pestana oculta, y se queda quieta si el
 * sistema pide menos movimiento.
 */
import TechIcon from "./TechIcon.astro";
import type { TechKey } from "../data/tech";

interface Props {
  label: string;
  /** tecnologias de los nodos grandes, en orden */
  techs: TechKey[];
}

const { label, techs } = Astro.props;
---

<div
  id="hero-canvas-wrap"
  data-layout="lado"
  class="absolute inset-0 z-0 overflow-hidden pointer-events-none left-1/2 -ml-[50vw] w-[100vw]"
  aria-hidden="true"
>
  <canvas
    id="hero-canvas"
    role="img"
    aria-label={label}
    class="block size-full"></canvas>

  {/* invisible hasta que el script los coloca: si no, aparecen un instante
      amontonados en la esquina superior izquierda */}
  {techs.map((tech, i) => (
    <span
      data-hub={i}
      class="invisible absolute left-0 top-0 grid size-9 place-items-center rounded-full bg-white/90 dark:bg-gray-900/90 ring-1 ring-black/10 dark:ring-white/15 shadow-md will-change-transform"
    >
      <TechIcon tech={tech} class="size-5" />
    </span>
  ))}
</div>

<style>
  /* Una sola mascara radial: la red queda densa a la derecha y se disuelve
     hacia el texto y los bordes. Con dos mascaras haria falta mask-composite,
     que no esta igual de asentado entre navegadores. */
  #hero-canvas {
    -webkit-mask-image: radial-gradient(
      ellipse 62% 78% at 72% 48%,
      #000 22%,
      transparent 76%
    );
    mask-image: radial-gradient(
      ellipse 62% 78% at 72% 48%,
      #000 22%,
      transparent 76%
    );
  }

  /* Sin sitio al lado del texto la red cubre el hero entero y baja de
     opacidad, logos incluidos: a plena intensidad, un nodo sobre la insignia
     o el titulo parecia un fallo de pintado, no un fondo. */
  #hero-canvas-wrap[data-layout="fondo"] #hero-canvas {
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(
      ellipse 90% 85% at 50% 50%,
      #000 30%,
      transparent 88%
    );
    mask-image: radial-gradient(
      ellipse 90% 85% at 50% 50%,
      #000 30%,
      transparent 88%
    );
  }

  #hero-canvas-wrap[data-layout="fondo"] [data-hub] {
    opacity: 0.6;
  }
</style>

<script>
  const wrap = document.getElementById("hero-canvas-wrap");
  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");

  if (wrap && canvas && ctx) {
    const menosMovimiento = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const chips = Array.from(wrap.querySelectorAll<HTMLElement>("[data-hub]"));
    const CHIP = 36; // size-9; el radio del chip manda en halos y margenes
    const R = CHIP / 2;

    type Nodo = {
      x: number; y: number;      // posicion base, en fraccion del lienzo
      vx: number; vy: number;    // deriva lenta
      r: number;                 // radio
      hub: boolean;              // lleva logo
      brillo: number;            // 0..1, sube al acercar el cursor
    };
    type Arista = { a: number; b: number };
    type Pulso = { arista: number; t: number; v: number };

    let ancho = 0;
    let alto = 0;
    let nodos: Nodo[] = [];
    let aristas: Arista[] = [];
    let pulsos: Pulso[] = [];
    let anchoSuficiente = false;
    let chipsVisibles = false;
    const raton = { x: -9999, y: -9999, activo: false };

    const CANT_PEQUENOS = 22;
    const DIST_ARISTA = 0.2; // en fraccion del lienzo

    const aleatorio = (min: number, max: number) =>
      min + Math.random() * (max - min);
    const limitar = (v: number, min: number, max: number) =>
      Math.min(max, Math.max(min, v));

    const construir = () => {
      // La banda de los logos se mide contra el borde real de la columna de
      // texto. Con fracciones fijas del lienzo, en cuanto cambiaba el ancho de
      // la ventana caian encima del parrafo y de las redes sociales.
      const cajaLienzo = wrap.getBoundingClientRect();
      const cajaTexto = document
        .getElementById("hero-content")
        ?.getBoundingClientRect();
      const bordeTexto = cajaTexto ? cajaTexto.right - cajaLienzo.left : 0;
      // hace falta sitio para el zigzag junto al texto; si no, la banda es el
      // hero entero: de lado a lado y casi de arriba abajo
      anchoSuficiente = ancho - bordeTexto >= 220;
      wrap.dataset.layout = anchoSuficiente ? "lado" : "fondo";

      const banda = anchoSuficiente
        ? { x0: (bordeTexto + CHIP) / ancho, x1: 0.95, y0: 0.14, dy: 0.72 }
        : { x0: 0.1, x1: 0.9, y0: 0.1, dy: 0.78 };

      const n = chips.length;
      const hubs: Nodo[] = chips.map((_, i) => {
        const t = n > 1 ? i / (n - 1) : 0.5;
        const zigzag = i % 2 === 0 ? 0.08 : 0.55;
        return {
          x: limitar(
            banda.x0 + (banda.x1 - banda.x0) * zigzag + aleatorio(-0.02, 0.02),
            0.06,
            0.94
          ),
          y: limitar(banda.y0 + t * banda.dy + aleatorio(-0.02, 0.02), 0.06, 0.94),
          vx: aleatorio(-0.00005, 0.00005),
          vy: aleatorio(-0.00005, 0.00005),
          r: 5,
          hub: true,
          brillo: 0,
        };
      });

      // Rejilla con jitter en vez de posiciones al azar: al azar salen grumos
      // y zonas vacias, y esto tiene que leerse como una red, no como ruido.
      const cols = 6;
      const filas = 5;
      const celdas: { cx: number; cy: number }[] = [];
      for (let f = 0; f < filas; f++) {
        for (let c = 0; c < cols; c++) {
          celdas.push({ cx: (c + 0.5) / cols, cy: (f + 0.5) / filas });
        }
      }
      for (let i = celdas.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [celdas[i], celdas[j]] = [celdas[j], celdas[i]];
      }

      const jitterX = 0.5 / cols;
      const jitterY = 0.5 / filas;

      const pequenos: Nodo[] = celdas.slice(0, CANT_PEQUENOS).map((celda) => ({
        x: limitar(celda.cx + aleatorio(-jitterX, jitterX), 0.04, 0.96),
        y: limitar(celda.cy + aleatorio(-jitterY, jitterY), 0.04, 0.96),
        vx: aleatorio(-0.00007, 0.00007),
        vy: aleatorio(-0.00007, 0.00007),
        r: aleatorio(1.6, 2.8),
        hub: false,
        brillo: 0,
      }));

      nodos = [...hubs, ...pequenos];

      aristas = [];
      // la cadena entre logos se traza siempre: es lo que hace que se lean
      // como un sistema y no como puntos sueltos que coinciden cerca
      for (let i = 0; i + 1 < hubs.length; i++) aristas.push({ a: i, b: i + 1 });

      for (let i = 0; i < nodos.length; i++) {
        for (let j = i + 1; j < nodos.length; j++) {
          if (i < hubs.length && j === i + 1 && j < hubs.length) continue;
          const dx = nodos[i].x - nodos[j].x;
          const dy = nodos[i].y - nodos[j].y;
          if (Math.hypot(dx, dy) < DIST_ARISTA) aristas.push({ a: i, b: j });
        }
      }

      // las peticiones se concentran donde estan los logos
      pulsos = [];
      aristas.forEach((e, i) => {
        const tocaHub = e.a < hubs.length || e.b < hubs.length;
        if (Math.random() < (tocaHub ? 0.85 : 0.3)) {
          pulsos.push({ arista: i, t: Math.random(), v: aleatorio(0.0022, 0.005) });
        }
      });
    };

    const redimensionar = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const caja = wrap.getBoundingClientRect();
      ancho = caja.width;
      alto = caja.height;
      canvas.width = Math.round(ancho * dpr);
      canvas.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const esOscuro = () => document.documentElement.classList.contains("dark");

    const pintar = () => {
      const oscuro = esOscuro();
      const colNodo = oscuro ? "148, 197, 253" : "37, 99, 235";
      const colHub = oscuro ? "129, 140, 248" : "79, 70, 229";
      const colArista = oscuro ? "148, 163, 184" : "71, 85, 105";

      ctx.clearRect(0, 0, ancho, alto);

      const px = (n: Nodo) => n.x * ancho;
      const py = (n: Nodo) => n.y * alto;

      // aristas
      ctx.lineWidth = 1;
      for (const e of aristas) {
        const a = nodos[e.a];
        const b = nodos[e.b];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        const alpha = (1 - Math.min(1, d / DIST_ARISTA)) * (oscuro ? 0.46 : 0.4);
        ctx.strokeStyle = `rgba(${colArista}, ${Math.max(0.09, alpha)})`;
        ctx.beginPath();
        ctx.moveTo(px(a), py(a));
        ctx.lineTo(px(b), py(b));
        ctx.stroke();
      }

      // peticiones viajando
      for (const p of pulsos) {
        const e = aristas[p.arista];
        if (!e) continue;
        const a = nodos[e.a];
        const b = nodos[e.b];
        const x = px(a) + (px(b) - px(a)) * p.t;
        const y = py(a) + (py(b) - py(a)) * p.t;

        const halo = ctx.createRadialGradient(x, y, 0, x, y, 7);
        halo.addColorStop(0, `rgba(${colNodo}, ${oscuro ? 0.9 : 0.75})`);
        halo.addColorStop(1, `rgba(${colNodo}, 0)`);
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(x, y, 7, 0, Math.PI * 2);
        ctx.fill();
      }

      // nodos pequenos
      for (const n of nodos) {
        if (n.hub) continue;
        ctx.fillStyle = `rgba(${colNodo}, 0.8)`;
        ctx.beginPath();
        ctx.arc(px(n), py(n), n.r, 0, Math.PI * 2);
        ctx.fill();
      }

      // logos: el lienzo pone el halo y el anillo, el chip HTML va encima.
      // El chip se sujeta dentro del lienzo aunque el nodo derive al borde.
      nodos.forEach((n, i) => {
        if (!n.hub) return;
        const x = limitar(px(n), R + 6, ancho - R - 6);
        const y = limitar(py(n), R + 6, alto - R - 6);
        const radioHalo = R + 12 + n.brillo * 12;

        const halo = ctx.createRadialGradient(x, y, R, x, y, radioHalo);
        halo.addColorStop(0, `rgba(${colHub}, ${0.22 + n.brillo * 0.4})`);
        halo.addColorStop(1, `rgba(${colHub}, 0)`);
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(x, y, radioHalo, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = `rgba(${colHub}, ${0.42 + n.brillo * 0.45})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(x, y, R + 3 + n.brillo * 3, 0, Math.PI * 2);
        ctx.stroke();

        const chip = chips[i];
        if (chip) {
          const escala = 1 + n.brillo * 0.12;
          chip.style.transform = `translate3d(${x - R}px, ${y - R}px, 0) scale(${escala})`;
        }
      });

      if (!chipsVisibles) {
        for (const chip of chips) chip.classList.remove("invisible");
        chipsVisibles = true;
      }
    };

    const avanzar = () => {
      for (const n of nodos) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0.05 || n.x > 0.95) n.vx *= -1;
        if (n.y < 0.05 || n.y > 0.95) n.vy *= -1;

        // brillo por cercania del cursor, con vuelta suave a su sitio
        let objetivo = 0;
        if (raton.activo && n.hub) {
          const d = Math.hypot(n.x * ancho - raton.x, n.y * alto - raton.y);
          objetivo = d < 150 ? 1 - d / 150 : 0;
        }
        n.brillo += (objetivo - n.brillo) * 0.12;
      }

      // el cursor separa suavemente los nodos cercanos
      if (raton.activo) {
        for (const n of nodos) {
          const dx = n.x * ancho - raton.x;
          const dy = n.y * alto - raton.y;
          const d = Math.hypot(dx, dy);
          if (d < 110 && d > 0.5) {
            const empuje = ((110 - d) / 110) * 0.0009;
            n.x += (dx / d) * empuje;
            n.y += (dy / d) * empuje;
          }
        }
      }

      for (const p of pulsos) {
        p.t += p.v;
        if (p.t > 1) {
          p.t = 0;
          p.v = aleatorio(0.0022, 0.005);
        }
      }
    };

    let raf = 0;
    let corriendo = false;

    const bucle = () => {
      avanzar();
      pintar();
      raf = requestAnimationFrame(bucle);
    };

    const arrancar = () => {
      if (corriendo || menosMovimiento) return;
      corriendo = true;
      raf = requestAnimationFrame(bucle);
    };

    const parar = () => {
      corriendo = false;
      cancelAnimationFrame(raf);
    };

    redimensionar();
    construir();
    pintar();

    if (!menosMovimiento) {
      // solo animar cuando esta en pantalla y la pestana visible
      const io = new IntersectionObserver(
        (entradas) => (entradas[0].isIntersecting ? arrancar() : parar()),
        { threshold: 0.05 }
      );
      io.observe(wrap);

      document.addEventListener("visibilitychange", () =>
        document.hidden ? parar() : arrancar()
      );
    }

    let anchoPrevio = ancho;
    window.addEventListener(
      "resize",
      () => {
        redimensionar();
        // rehacer solo en saltos grandes: la banda depende del ancho, pero
        // reconstruir en cada pixel de arrastre marea
        if (Math.abs(ancho - anchoPrevio) > 120) {
          construir();
          anchoPrevio = ancho;
        }
        pintar();
      },
      { passive: true }
    );

    // El lienzo no recibe eventos, va detras del texto y con pointer-events
    // desactivados para no comerse los enlaces. Se escucha en el documento y
    // se descarta lo que cae fuera del hero.
    document.addEventListener(
      "pointermove",
      (e) => {
        const caja = wrap.getBoundingClientRect();
        const x = e.clientX - caja.left;
        const y = e.clientY - caja.top;
        raton.activo =
          x >= 0 && y >= 0 && x <= caja.width && y <= caja.height;
        raton.x = x;
        raton.y = y;
      },
      { passive: true }
    );
  }
</script>
