---
interface Props {
  href: string;
  class?: string;
  /**
   * Los enlaces externos abren en pestana nueva; los internos, no.
   * Sin esto, el caso de estudio del propio sitio abriria otra pestana.
   */
  external?: boolean;
}

// antes se descartaba la prop `class` que le pasaban los proyectos
const { href, class: className = "", external = true } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-flex bg-gray-100 text-gray-800 border-gray-300 items-center justify-center gap-2 px-3 py-2 text-base transition dark:text-white dark:bg-gray-800 border dark:border-gray-600 hover:bg-black/85 hover:border-gray-900 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:ring focus-visible:ring-blue-500 focus-visible:ring-offset-2 active:bg-black",
    className,
  ]}
>
  <slot />
</a>
