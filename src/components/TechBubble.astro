---
interface Props {
  Icon: any;
  label: string;
  link: string;
  visitLabel: string;
}

const { Icon, label, link, visitLabel } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  title={`${visitLabel} ${label}`}
  class="group flex flex-col items-center justify-center gap-1 w-20 h-20 rounded-xl shadow-sm bg-gray-300 hover:bg-gray-400 dark:bg-white/5 dark:hover:bg-white/10 hover:shadow-md transition-all duration-200 focus-visible:outline-2 focus-visible:outline-blue-600"
>
  <Icon class="w-7 h-7" />
  <span
    class="text-xs text-center leading-tight text-gray-900 group-hover:text-blue-800 dark:text-white/85 dark:group-hover:text-blue-200"
  >
    {label}
  </span>
</a>
