---
/**
 * Si la tecnologia aparece en algun proyecto, la burbuja filtra las tarjetas
 * que la usan. Para no perder el acceso al sitio oficial, se anade un icono
 * de enlace externo en la esquina: son dos acciones distintas y por eso son
 * dos elementos distintos. Un <a> no puede ir dentro de un <button>, asi que
 * ambos son hermanos dentro de un contenedor posicionado.
 */
import TechIcon from "./TechIcon.astro";
import type { TechKey } from "../data/tech";

interface Props {
  tech: TechKey;
  label: string;
  link: string;
  visitLabel: string;
  usos: number;
  /** aparece en casi todos los proyectos: se marca distinto para no dar a
      entender que caracteriza a ninguno */
  transversal: boolean;
  filterLabel: string;
  transversalLabel: string;
  projectsWord: string;
}

const {
  tech,
  label,
  link,
  visitLabel,
  usos,
  transversal,
  filterLabel,
  transversalLabel,
  projectsWord,
} = Astro.props;

const esFiltro = usos > 0;

const baldosa =
  "absolute inset-0 flex flex-col items-center justify-center gap-1 rounded-xl shadow-sm " +
  "bg-gray-300 dark:bg-white/5 transition-all duration-200 " +
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 " +
  (esFiltro
    ? "cursor-pointer hover:bg-gray-400 dark:hover:bg-white/15 hover:shadow-md " +
      // Seleccionado con anillo y un tinte muy leve, no con un relleno solido:
      // cualquier color de fondo termina chocando con el color propio de algun
      // logo, y asi el icono queda siempre sobre el fondo con el que se diseno.
      "aria-pressed:bg-blue-500/20 dark:aria-pressed:bg-blue-400/20 " +
      "aria-pressed:ring-2 aria-pressed:ring-blue-600 dark:aria-pressed:ring-blue-400 " +
      "aria-pressed:shadow-md"
    : "hover:bg-gray-400 dark:hover:bg-white/10 hover:shadow-md");

const etiqueta =
  "text-xs text-center leading-tight text-gray-900 dark:text-white/85 " +
  "group-hover:text-blue-800 dark:group-hover:text-blue-200 " +
  "group-aria-pressed:font-bold group-aria-pressed:text-blue-800 " +
  "dark:group-aria-pressed:text-blue-200";
---

<div class="group relative w-20 h-20 transition-transform hover:-translate-y-0.5">
  {
    esFiltro ? (
      <button
        type="button"
        data-tech-filter={tech}
        aria-pressed="false"
        title={
          transversal
            ? `${transversalLabel} (${usos} ${projectsWord})`
            : `${filterLabel} ${label}`
        }
        aria-label={`${filterLabel} ${label} (${usos} ${projectsWord})`}
        class={baldosa}
      >
        <TechIcon tech={tech} class="w-7 h-7" />
        <span class={etiqueta}>{label}</span>
      </button>
    ) : (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        title={`${visitLabel} ${label}`}
        class={baldosa}
      >
        <TechIcon tech={tech} class="w-7 h-7" />
        <span class={etiqueta}>{label}</span>
      </a>
    )
  }

  {
    esFiltro && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        title={`${visitLabel} ${label}`}
        aria-label={`${visitLabel} ${label}`}
        class="absolute top-1 left-1 z-10 grid place-items-center size-5 rounded-md
        text-gray-600 dark:text-gray-300 opacity-45 transition
        hover:opacity-100 hover:bg-black/10 dark:hover:bg-white/15 hover:text-blue-700 dark:hover:text-blue-300
        focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-blue-600"
      >
        <svg
          class="w-3 h-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 4h6v6" />
          <path d="M20 4 11 13" />
          <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </svg>
      </a>
    )
  }

  {
    esFiltro && (
      <span
        class:list={[
          "pointer-events-none absolute -top-1.5 -right-1.5 grid place-items-center min-w-5 h-5 px-1 rounded-full",
          "text-white text-[10px] font-bold shadow ring-2 ring-gray-100 dark:ring-gray-900",
          transversal ? "bg-slate-500" : "bg-blue-600",
        ]}
      >
        {usos}
      </span>
    )
  }
</div>
