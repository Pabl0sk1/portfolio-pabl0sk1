---
/**
 * Si la tecnologia aparece en algun proyecto se comporta como filtro y no
 * como enlace: pulsarla deja visibles solo las tarjetas que la usan. Las que
 * no tienen proyectos siguen siendo un enlace al sitio oficial.
 */
import TechIcon from "./TechIcon.astro";
import type { TechKey } from "../data/tech";

interface Props {
  tech: TechKey;
  label: string;
  link: string;
  visitLabel: string;
  usos: number;
  /** aparece en casi todos los proyectos: se marca distinto para no dar a
      entender que caracteriza a ninguno */
  transversal: boolean;
  filterLabel: string;
  transversalLabel: string;
  projectsWord: string;
}

const {
  tech,
  label,
  link,
  visitLabel,
  usos,
  transversal,
  filterLabel,
  transversalLabel,
  projectsWord,
} = Astro.props;

const esFiltro = usos > 0;

const base =
  "group relative flex flex-col items-center justify-center gap-1 w-20 h-20 rounded-xl shadow-sm " +
  "bg-gray-300 dark:bg-white/5 transition-all duration-200 " +
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600";

const interactivo = esFiltro
  ? " cursor-pointer hover:bg-gray-400 dark:hover:bg-white/15 hover:shadow-md hover:-translate-y-0.5 " +
    "aria-pressed:bg-blue-600 aria-pressed:text-white dark:aria-pressed:bg-blue-500"
  : " hover:bg-gray-400 dark:hover:bg-white/10 hover:shadow-md";

const etiqueta =
  "text-xs text-center leading-tight text-gray-900 dark:text-white/85 " +
  "group-hover:text-blue-800 dark:group-hover:text-blue-200 " +
  "group-aria-pressed:text-white dark:group-aria-pressed:text-white";
---

{
  esFiltro ? (
    <button
      type="button"
      data-tech-filter={tech}
      aria-pressed="false"
      title={
        transversal
          ? `${transversalLabel} (${usos} ${projectsWord})`
          : `${filterLabel} ${label}`
      }
      aria-label={`${filterLabel} ${label} (${usos} ${projectsWord})`}
      class={base + interactivo}
    >
      <TechIcon tech={tech} class="w-7 h-7" />
      <span class={etiqueta}>{label}</span>
      <span
        class:list={[
          "absolute -top-1.5 -right-1.5 grid place-items-center min-w-5 h-5 px-1 rounded-full",
          "text-white text-[10px] font-bold shadow ring-2 ring-gray-100 dark:ring-gray-900",
          transversal ? "bg-slate-500" : "bg-blue-600",
        ]}
      >
        {usos}
      </span>
    </button>
  ) : (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      title={`${visitLabel} ${label}`}
      class={base + interactivo}
    >
      <TechIcon tech={tech} class="w-7 h-7" />
      <span class={etiqueta}>{label}</span>
    </a>
  )
}
