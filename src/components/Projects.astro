---
/**
 * Mosaico de proyectos con detalle desplegable.
 *
 * Antes eran seis tarjetas iguales en dos columnas: Faro, en produccion con un
 * cliente real, se leia igual que un trabajo de aprendizaje. Ahora el tamano de
 * la pieza da la jerarquia y la descripcion larga se guarda en un panel que se
 * abre bajo su fila.
 *
 * La pieza entera es un <button>: los enlaces viven solo dentro del panel, asi
 * no hay anclas anidadas dentro de un control.
 */
import { Image, getImage } from "astro:assets";
import LinkIcon from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import TechIcon from "./TechIcon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { projects as projectsText } from "../i18n/content";
import { PROJECTS } from "../data/projects";
import { anchos } from "../data/mosaico";
import { TECH } from "../data/tech";
// el monograma en sus dos versiones: la oscura para fondo claro y al reves.
// El tema va por clase, asi que se pintan las dos y una se oculta con CSS
import elbruxClaro from "../assets/elbrux.webp";
import elbruxOscuro from "../assets/elbrux-dark.webp";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// el texto sale del diccionario y el resto de data/projects.ts, emparejados por
// indice; el orden del mosaico se aplica despues, y el ancho sale del reparto
const ANCHOS = anchos(PROJECTS.length);
const TARJETAS = projectsText[lang]
  .map((texto, i) => ({ ...texto, ...PROJECTS[i] }))
  .sort((a, b) => a.orden - b.orden)
  .map((tarjeta, i) => ({ ...tarjeta, span: ANCHOS[i] }));

// La captura a tamano completo, para la lupa. El <Image> del panel sirve
// recortes de hasta 520 px de ancho: al ampliarla se veia el recorte estirado
// y borroso. Aqui se pide el ancho original una sola vez por proyecto, y la
// URL viaja en un atributo en vez de como <img> escondido, que descargaria
// las diez capturas grandes en cuanto carga la pagina.
const CAPTURAS = new Map(
  await Promise.all(
    TARJETAS.map(
      async (tarjeta) =>
        [
          tarjeta.slug,
          (
            await getImage({
              src: tarjeta.image,
              width: tarjeta.image.width,
              format: "webp",
              quality: 90,
            })
          ).src,
        ] as const
    )
  )
);

// Se agrupa por filas porque los paneles van despues de la fila entera, no
// entre medias. La fila se cierra cuando los `span` suman las tres columnas
// del mosaico, asi que sale de dos piezas (2+1) o de tres (1+1+1). Antes se
// cortaba de dos en dos, que solo vale mientras no haya ninguna fila de tres.
const FILAS: (typeof TARJETAS)[] = [];
let enCurso: typeof TARJETAS = [];
let columnas = 0;
for (const tarjeta of TARJETAS) {
  enCurso.push(tarjeta);
  columnas += tarjeta.span;
  if (columnas >= 3) {
    FILAS.push(enCurso);
    enCurso = [];
    columnas = 0;
  }
}
// una fila incompleta al final deja hueco, pero es preferible a perderla
if (enCurso.length) FILAS.push(enCurso);

// Desplazamiento de cada fila en el orden de movil: dos huecos por pieza, el
// suyo y el de su panel. Se acumula en vez de multiplicar por un tamano fijo,
// que ya no lo hay.
const BASE: number[] = [];
let hueco = 0;
for (const f of FILAS) {
  BASE.push(hueco);
  hueco += f.length * 2;
}
---

<div class="max-w-6xl mx-auto px-4">
  {/* Aviso del filtro activo; el script lo muestra y lo rellena */}
  <div
    id="filter-bar"
    hidden
    data-template={t("projects.filterActive")}
    class="mb-8 flex flex-wrap items-center gap-3 rounded-xl bg-blue-500/10 ring-1 ring-blue-500/30 px-4 py-3"
  >
    <span id="filter-text" class="text-sm text-gray-800 dark:text-gray-200"></span>
    <button
      type="button"
      id="filter-clear"
      class="ml-auto text-sm font-semibold text-blue-700 dark:text-blue-300 underline underline-offset-2 hover:no-underline cursor-pointer focus-visible:outline-2 focus-visible:outline-blue-600 rounded"
    >
      {t("projects.clearFilter")}
    </button>
  </div>

  {/* Solo hay separacion entre columnas: la vertical la ponen las piezas con
      su `mb-4`, y la del panel abierto va dentro de su propia animacion.
      Con `gap-4` cada panel cerrado se llevaba un hueco entero pese a medir
      0 px: ocupa su fila igual, y el gap cuenta a los dos lados. Entre dos
      filas quedaban 48 px, y 64 en la fila de tres piezas. */}
  <div id="projects-grid" class="grid gap-x-4 md:grid-cols-3 md:[grid-auto-flow:dense]">
    {
      FILAS.map((fila, iFila) => (
        /* contents: las piezas y los paneles entran en la rejilla exterior,
           pero el agrupado mantiene los paneles despues de la fila entera */
        <div class="contents">
          {fila.map(({ title, resumen, image, logo, tags, transversal, span, slug, elbrux, year }, i) => (
            /* data-span y no una clase de Tailwind: el script lo reescribe al
               filtrar. Las reglas estan en el <style>, dentro de la media
               query, que en movil la pieza ocupa siempre el ancho entero */
            <button
              type="button"
              style={`--orden:${BASE[iFila] + i * 2}`}
              data-tile={slug}
              data-project={slug}
              data-tags={[...tags, ...transversal].join(" ")}
              aria-expanded="false"
              aria-controls={`panel-${slug}`}
              aria-label={`${title}${elbrux ? ` · ${t("projects.elbrux")}` : ""} · ${year}: ${t("projects.expand")}`}
              class:list={[
                "group relative isolate mb-4 flex h-64 flex-col justify-end overflow-hidden rounded-2xl text-left",
                "ring-1 ring-black/10 dark:ring-white/10 shadow-sm transition",
                "hover:shadow-lg hover:ring-blue-500/40 cursor-pointer",
                "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600",
                "aria-expanded:ring-blue-500/60",
              ]}
              data-span={span}
            >
              {/* widths + sizes: la pieza ocupa el ancho entero en movil y
                   hasta dos columnas en escritorio. Antes salia siempre a
                   1280 px, tambien en pantallas de densidad normal. */}
              <Image
                src={image}
                alt={`${t("projects.imageAlt")} ${title}`}
                widths={[400, 640, 1024, 1280]}
                sizes="(max-width: 767px) 100vw, 600px"
                loading="lazy"
                class="absolute inset-0 -z-10 size-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              />
              {/* velo: las capturas son claras y el texto va encima */}
              <span
                class="absolute inset-0 -z-10 bg-gradient-to-t from-gray-950 via-gray-950/75 to-gray-950/15"
                aria-hidden="true"
              />

              {/* a la izquierda porque la derecha la ocupa el numero. El
                  monograma solo no identifica la marca a este tamano, asi que
                  va con la palabra al lado */}
              {elbrux && (
                <span class="absolute left-4 top-4 flex items-center gap-1.5 rounded-full bg-white/85 dark:bg-black/40 px-2.5 py-1 ring-1 ring-black/10 dark:ring-white/20 backdrop-blur-sm">
                  {/* la pildora cambia de color con el monograma, no solo el
                      monograma: el velo de la pieza es oscuro en los dos
                      temas, y la version navy sobre fondo oscuro no se lee */}
                  <Image
                    src={elbruxClaro}
                    alt=""
                    width={32}
                    densities={[1, 2]}
                    loading="lazy"
                    class="size-4 object-contain dark:hidden"
                  />
                  <Image
                    src={elbruxOscuro}
                    alt=""
                    width={32}
                    densities={[1, 2]}
                    loading="lazy"
                    class="hidden size-4 object-contain dark:block"
                  />
                  <span class="text-[0.7rem] font-semibold uppercase tracking-wider text-gray-900 dark:text-white">
                    ELBRUX
                  </span>
                </span>
              )}

              {/* fondo propio: el velo de la pieza arriba es casi
                  transparente y el numero se perdia contra la captura. Lleva
                  el mismo tratamiento por tema que el distintivo de la
                  esquina opuesta, para que las dos se lean igual.

                  El ano va pegado al numero y con el mismo tratamiento: son
                  las dos etiquetas de la pieza, y separadas por la captura
                  cada una necesitaria su propio fondo igual. Ambas quedan
                  fuera del arbol de accesibilidad porque el `aria-label` del
                  boton ya nombra el ano; lo de dentro no se lee. */}
              <span
                class="absolute right-4 top-4 flex items-center gap-1.5"
                aria-hidden="true"
              >
                <span class="grid h-7 place-items-center rounded-full bg-white/85 dark:bg-black/40 px-2.5 ring-1 ring-black/10 dark:ring-white/20 backdrop-blur-sm font-mono text-xs font-bold tabular-nums text-gray-900/70 dark:text-white/70">
                  {year}
                </span>
                <span class="grid size-7 place-items-center rounded-full bg-white/85 dark:bg-black/40 ring-1 ring-black/10 dark:ring-white/20 backdrop-blur-sm font-mono text-xs font-bold tabular-nums text-gray-900/70 dark:text-white/70">
                  {String(TARJETAS.findIndex((p) => p.slug === slug) + 1).padStart(2, "0")}
                </span>
              </span>

              <span class="relative p-5">
                {/* Chapa blanca y no la marca suelta sobre el velo: unas estan
                    dibujadas para fondo claro (el faro de Faro, el vinilo de
                    Pulse) y desaparecian contra el degradado oscuro, que es
                    oscuro en los dos temas. Con la chapa las diez se leen
                    igual y ademas quedan alineadas entre piezas.

                    Decorativa: el titulo va al lado y el boton ya lo nombra
                    en su `aria-label`. */}
                <span class="flex items-start gap-3">
                  <Image
                    src={logo}
                    alt=""
                    width={128}
                    densities={[1, 2]}
                    loading="lazy"
                    class="mt-0.5 size-10 shrink-0 rounded-lg bg-white/90 object-contain p-1 ring-1 ring-black/10 shadow-sm"
                  />

                  <span class="min-w-0">
                    <span class="block text-lg font-bold text-white text-pretty">
                      {title}
                    </span>
                    <span class="mt-0.5 block text-sm text-gray-300 text-pretty">
                      {resumen}
                    </span>
                  </span>
                </span>

                <span class="mt-3 flex items-center gap-3">
                  {/* el stack va en texto y no en iconos: a este tamano son
                      manchas de color, y los logos oscuros como PostgreSQL o
                      Java se pierden sobre el velo. Los iconos van en el panel */}
                  {/* en las piezas estrechas caben dos: con tres se cortaba
                      justo en el contador. Van las dos versiones y elige el
                      CSS, porque el ancho de la pieza cambia al filtrar y asi
                      la lista correcta ya sale bien en el primer pintado */}
                  <span class="min-w-0 truncate text-xs font-medium text-gray-400">
                    {[3, 2].map((cuantas) => (
                      <span data-stack={cuantas}>
                        {tags.slice(0, cuantas).map((k) => TECH[k].label).join(" · ")}
                        {tags.length > cuantas && ` +${tags.length - cuantas}`}
                      </span>
                    ))}
                  </span>

                  <span
                    class="ml-auto grid size-8 place-items-center rounded-full bg-white/10 text-white ring-1 ring-white/20 transition group-hover:bg-white/20 group-aria-expanded:rotate-45"
                    aria-hidden="true"
                  >
                    <svg
                      class="size-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                </span>
              </span>
            </button>
          ))}

          {fila.map(({ title, description, image, logo, tags, transversal, link, slug, elbrux, year }, i) => (
            /* rejilla de una fila de 0fr a 1fr: se puede animar la altura sin
               conocerla de antemano, que con height:auto no se puede */
            <div
              id={`panel-${slug}`}
              style={`--orden:${BASE[iFila] + i * 2 + 1}`}
              data-panel={slug}
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 motion-reduce:transition-none data-[abierto]:grid-rows-[1fr] md:col-span-3"
            >
              <div class="overflow-hidden">
                <div class="mb-4 rounded-2xl bg-white/60 dark:bg-white/[0.04] ring-1 ring-black/10 dark:ring-white/10 p-5 sm:p-6">
                  <div class="grid gap-6 md:grid-cols-2">
                    {/* h-full: la captura llena la columna en vez de quedarse
                        en su alto natural. Sin esto, la columna de texto
                        —siempre mas alta— dejaba un hueco muerto bajo la
                        imagen. Recorta por abajo, como ya hace la pieza del
                        mosaico. En movil no cambia nada: como cada uno tiene
                        su fila, el 100% resuelve al alto natural.

                        object-left-top y no object-top: cuanto mas alta es la
                        columna de texto mas recorta, y las capturas nuevas son
                        muy apaisadas. Anclando a la izquierda se pierde solo el
                        borde derecho, y las barras laterales quedan enteras. */}
                    {/* La captura del panel va recortada para llenar la
                        columna, asi que aqui se abre entera en un <dialog>.
                        Es un boton y no un enlace: no lleva a ninguna parte,
                        y asi el teclado la alcanza con la semantica correcta. */}
                    <button
                      type="button"
                      data-zoom={CAPTURAS.get(slug)}
                      data-zoom-alt={`${t("projects.imageAlt")} ${title}`}
                      title={t("projects.zoom")}
                      aria-label={`${t("projects.zoom")}: ${title}`}
                      class="group/zoom relative block size-full cursor-zoom-in overflow-hidden rounded-xl ring-1 ring-black/10 dark:ring-white/10 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                    >
                      <Image
                        src={image}
                        alt={`${t("projects.imageAlt")} ${title}`}
                        widths={[400, 640, 1024, 1280]}
                        sizes="(max-width: 767px) 100vw, 520px"
                        loading="lazy"
                        class="size-full object-cover object-left-top transition-transform duration-500 motion-reduce:transition-none group-hover/zoom:scale-[1.03]"
                      />

                      {/* visible siempre y no solo al pasar el raton: en tactil
                          no hay hover y la lupa seria un secreto */}
                      <span
                        class="pointer-events-none absolute right-3 top-3 grid size-9 place-items-center rounded-full bg-gray-950/60 text-white ring-1 ring-white/25 backdrop-blur-sm opacity-80 transition group-hover/zoom:opacity-100"
                        aria-hidden="true"
                      >
                        <svg
                          class="size-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="11" cy="11" r="7" />
                          <path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
                        </svg>
                      </span>
                    </button>

                    <div class="flex flex-col">
                      <div class="flex items-start gap-3">
                        <Image
                          src={logo}
                          alt=""
                          width={128}
                          densities={[1, 2]}
                          loading="lazy"
                          class="size-11 shrink-0 rounded-xl bg-white object-contain p-1.5 ring-1 ring-black/10 dark:ring-white/15 shadow-sm"
                        />

                        {/* baseline y no center: el ano es mucho mas pequeno
                            que el titulo y centrado quedaba flotando */}
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                          <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                            {title}
                          </h3>
                          <span class="font-mono text-sm font-semibold tabular-nums text-gray-500 dark:text-gray-400">
                            {year}
                          </span>
                        </div>
                      </div>

                      {elbrux && (
                        <a
                          href="#experiencia"
                          title={t("projects.elbruxLink")}
                          class="mt-2 inline-flex w-fit items-center gap-2 rounded-full bg-black/5 dark:bg-white/10 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-200 ring-1 ring-black/10 dark:ring-white/10 transition hover:bg-black/10 dark:hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                        >
                          <Image
                            src={elbruxClaro}
                            alt=""
                            width={32}
                            densities={[1, 2]}
                            loading="lazy"
                            class="size-4 object-contain dark:hidden"
                          />
                          <Image
                            src={elbruxOscuro}
                            alt=""
                            width={32}
                            densities={[1, 2]}
                            loading="lazy"
                            class="hidden size-4 object-contain dark:block"
                          />
                          {t("projects.elbrux")}
                        </a>
                      )}
                      <p class="mt-3 grow text-sm text-gray-700 dark:text-gray-300 text-pretty">
                        {description}
                      </p>

                      <div class="mt-4 flex flex-wrap gap-2">
                        {tags.map((key) => (
                          <span class="flex items-center gap-1.5 rounded-md bg-black/5 dark:bg-white/10 px-2 py-1 text-xs font-medium text-gray-800 dark:text-gray-200">
                            <TechIcon tech={key} class="size-4" />
                            {TECH[key].label}
                          </span>
                        ))}
                      </div>

                      {transversal.length > 0 && (
                        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                          {transversal.map((k) => TECH[k].label).join(" · ")}
                        </p>
                      )}

                      {link && (
                        <div class="mt-5 flex flex-wrap items-center gap-3">
                          <LinkButton href={link} class="text-sm px-3 py-1">
                            <LinkIcon class="w-4 h-4" /> {t("projects.website")}
                          </LinkButton>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <p
    id="filter-empty"
    hidden
    class="text-center text-gray-600 dark:text-gray-400 py-10"
  >
    {t("projects.noResults")}
  </p>
</div>

{/*
  Uno solo para las diez capturas: el <dialog> nativo trae capa superior,
  ::backdrop, cierre con Escape, foco atrapado y el resto de la pagina inerte.
  Hecho a mano con un div haria falta reimplementar las cinco cosas.

  Vive fuera de #projects-grid: dentro heredaba `display: contents` y las
  reglas de orden del mosaico.
*/}
<dialog
  id="lightbox"
  aria-label={t("projects.zoom")}
  class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 backdrop:bg-gray-950/80 backdrop:backdrop-blur-sm"
>
  <div class="relative">
    {/* sin `src` de salida: se rellena al abrir, para no bajar diez capturas
        grandes en la carga inicial */}
    <img
      id="lightbox-img"
      alt=""
      class="block max-h-[88vh] max-w-[92vw] rounded-xl object-contain shadow-2xl ring-1 ring-white/15"
    />

    <button
      type="button"
      id="lightbox-close"
      title={t("projects.zoomClose")}
      aria-label={t("projects.zoomClose")}
      class="absolute -right-3 -top-3 grid size-9 cursor-pointer place-items-center rounded-full bg-white text-gray-900 shadow-lg ring-1 ring-black/10 transition hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
</dialog>

<style>
  /* En una sola columna, agrupar por filas deja el panel detras de la pieza
     siguiente: el detalle de BioTech aparecia debajo de Shop Easy. Se reordena
     a pieza-panel-pieza-panel. En escritorio no se toca, que ahi el agrupado
     es justo lo que hace que el panel salga bajo la fila entera. */
  @media (max-width: 767px) {
    #projects-grid > div > * {
      order: var(--orden);
    }
  }

  /* El ancho de cada pieza. Va aqui y no en clases de Tailwind porque el
     script lo reescribe al filtrar. Solo en escritorio: en movil la rejilla es
     de una columna y un `span 2` le inventaria una segunda. El id gana en
     especificidad a las utilidades. */
  @media (min-width: 768px) {
    #projects-grid > div > button[data-span="1"] {
      grid-column: span 1 / span 1;
    }

    #projects-grid > div > button[data-span="2"] {
      grid-column: span 2 / span 2;
    }
  }

  /* De las dos listas de stack, la corta es solo para las piezas estrechas de
     escritorio: en movil la pieza ocupa el ancho entero y cabe la larga. */
  [data-stack="2"] {
    display: none;
  }

  @media (min-width: 768px) {
    button[data-span="1"] [data-stack="3"] {
      display: none;
    }

    button[data-span="1"] [data-stack="2"] {
      display: inline;
    }
  }
</style>

<script>
  import { anchos } from "../data/mosaico";

  // --- Detalle desplegable -------------------------------------------------
  // Solo un panel abierto a la vez: dos paneles abiertos dejan el mosaico
  // partido y obligan a buscar cual es cual.
  const piezas = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-tile]")
  );

  const panelDe = (slug: string) =>
    document.querySelector<HTMLElement>(`[data-panel="${slug}"]`);

  const cerrar = (pieza: HTMLButtonElement) => {
    const panel = panelDe(pieza.dataset.tile!);
    pieza.setAttribute("aria-expanded", "false");
    if (panel) {
      delete panel.dataset.abierto;
      panel.inert = true;
    }
  };

  for (const pieza of piezas) {
    // cerrado de salida: fuera del orden de tabulacion hasta que se abra
    const panel = panelDe(pieza.dataset.tile!);
    if (panel) panel.inert = true;

    pieza.addEventListener("click", () => {
      const abierto = pieza.getAttribute("aria-expanded") === "true";
      for (const otra of piezas) cerrar(otra);
      if (abierto) return;

      const suyo = panelDe(pieza.dataset.tile!);
      pieza.setAttribute("aria-expanded", "true");
      if (suyo) {
        suyo.dataset.abierto = "";
        suyo.inert = false;
      }
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    // con la lupa abierta, Escape es suyo: si no, la misma pulsacion cerraba
    // tambien el panel de debajo y se perdia el sitio
    if (document.querySelector<HTMLDialogElement>("#lightbox")?.open) return;
    const abierta = piezas.find(
      (p) => p.getAttribute("aria-expanded") === "true"
    );
    if (!abierta) return;
    cerrar(abierta);
    abierta.focus();
  });

  // --- Captura a tamano completo -------------------------------------------
  const lupa = document.querySelector<HTMLDialogElement>("#lightbox");
  const lupaImg = document.querySelector<HTMLImageElement>("#lightbox-img");

  if (lupa && lupaImg) {
    // Sin bloqueo de scroll a mano: el <dialog> modal vive en la capa
    // superior, cuyo padre a efectos de encadenar el scroll es el <body>, que
    // ya tiene overflow:hidden. La rueda no llega a #scroll-area ni sobre la
    // imagen ni sobre el velo. Un `overflow:hidden` propio, ademas, tendria
    // que ser en linea —la regla de #scroll-area gana a cualquier utilidad— y
    // al quitar la barra desplazaria el contenido de detras.
    const abrirLupa = (src: string, alt: string) => {
      lupaImg.src = src;
      lupaImg.alt = alt;
      lupa.showModal();
    };

    for (const boton of document.querySelectorAll<HTMLButtonElement>("[data-zoom]")) {
      boton.addEventListener("click", () =>
        abrirLupa(boton.dataset.zoom!, boton.dataset.zoomAlt ?? "")
      );
    }

    document.getElementById("lightbox-close")?.addEventListener("click", () => {
      lupa.close();
    });

    // pulsar el velo cierra. El click del fondo llega al propio <dialog>,
    // porque su contenido esta dentro de un hijo que lo tapa entero
    lupa.addEventListener("click", (e) => {
      if (e.target === lupa) lupa.close();
    });

    lupa.addEventListener("close", () => {
      // se suelta la imagen para no dejar la grande en memoria
      lupaImg.removeAttribute("src");
      lupaImg.alt = "";
    });
  }

  // --- Filtrado de proyectos por tecnologia --------------------------------
  // El estado vive en la URL (?tech=python) para que el filtro se pueda
  // compartir y para que el boton atras del navegador funcione.
  const barra = document.getElementById("filter-bar");
  const texto = document.getElementById("filter-text");
  const vacio = document.getElementById("filter-empty");
  const limpiar = document.getElementById("filter-clear");

  const botones = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-tech-filter]")
  );
  const tarjetas = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project]")
  );

  if (botones.length && tarjetas.length) {
    const plantilla = barra?.dataset.template ?? "";

    const aplicar = (tech: string | null, hacerScroll: boolean) => {
      // se cierran todos: el reparto cambia, y un panel abierto se quedaria
      // colocado bajo una fila que ya no es la suya
      for (const pieza of piezas) cerrar(pieza);

      let visibles = 0;

      for (const card of tarjetas) {
        const tags = (card.dataset.tags ?? "").split(" ");
        const mostrar = !tech || tags.includes(tech);
        card.hidden = !mostrar;
        if (mostrar) visibles++;
      }

      // el ancho se reparte otra vez con las que quedan a la vista: con los
      // anchos de todas, filtrar dejaba huecos o una pieza suelta al final
      const reparto = anchos(visibles);
      let iVisible = 0;
      for (const card of tarjetas) {
        if (!card.hidden) card.dataset.span = String(reparto[iVisible++]);
      }

      for (const b of botones) {
        b.setAttribute("aria-pressed", String(b.dataset.techFilter === tech));
      }

      if (barra && texto) {
        barra.hidden = !tech;
        if (tech) {
          const etiqueta =
            botones
              .find((b) => b.dataset.techFilter === tech)
              ?.querySelector("span")?.textContent ?? tech;
          texto.textContent = plantilla
            .replace("{n}", String(visibles))
            .replace("{tech}", etiqueta);
        }
      }

      if (vacio) vacio.hidden = visibles > 0;

      if (hacerScroll) {
        document.getElementById("proyectos")?.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      }
    };

    const leerUrl = () => new URL(location.href).searchParams.get("tech");

    const navegar = (tech: string | null) => {
      const url = new URL(location.href);
      if (tech) url.searchParams.set("tech", tech);
      else url.searchParams.delete("tech");
      history.pushState({}, "", url);
    };

    for (const b of botones) {
      b.addEventListener("click", () => {
        const tech = b.dataset.techFilter!;
        // volver a pulsar la misma tecnologia quita el filtro
        const siguiente = leerUrl() === tech ? null : tech;
        navegar(siguiente);
        aplicar(siguiente, Boolean(siguiente));
      });
    }

    limpiar?.addEventListener("click", () => {
      navegar(null);
      aplicar(null, false);
    });

    window.addEventListener("popstate", () => aplicar(leerUrl(), false));

    // estado inicial, por si se llega con ?tech= ya en el enlace
    aplicar(leerUrl(), false);
  }
</script>
