---
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Cada campo lleva id + label[for] asociado: sin eso, los lectores de
// pantalla no relacionan la etiqueta con su input.
const FIELDS = [
  {
    id: "contact-name",
    name: "name",
    label: t("form.name"),
    type: "text",
    autocomplete: "name",
  },
  {
    id: "contact-email",
    name: "email",
    label: t("form.email"),
    type: "email",
    autocomplete: "email",
  },
  {
    id: "contact-subject",
    name: "subject",
    label: t("form.subject"),
    type: "text",
    autocomplete: "off",
  },
] as const;

const inputClass =
  "mt-2 p-2 rounded-lg bg-gray-200 text-black dark:bg-white/10 dark:text-white border border-gray-400/60 dark:border-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500";

// un formulario de Netlify por idioma, para que la pagina de gracias coincida
const formName = lang === "es" ? "contact" : "contact-en";
---

<form
  name={formName}
  method="POST"
  action={localizePath("/thanks", lang)}
  data-netlify="true"
  netlify-honeypot="bot-field"
  enctype="multipart/form-data"
  class="flex flex-col gap-4 bg-black/10 dark:bg-white/5 p-6 rounded-xl shadow-lg text-gray-900 dark:text-gray-300"
>
  <input type="hidden" name="form-name" value={formName} />
  <p class="hidden">
    <label>{t("form.honeypot")} <input name="bot-field" tabindex="-1" /></label>
  </p>

  {
    FIELDS.map(({ id, name, label, type, autocomplete }) => (
      <div class="flex flex-col">
        <label class="text-sm font-medium" for={id}>
          {label}
        </label>
        <input
          id={id}
          type={type}
          name={name}
          autocomplete={autocomplete}
          class={inputClass}
          required
        />
      </div>
    ))
  }

  <div class="flex flex-col">
    <label class="text-sm font-medium" for="contact-message">
      {t("form.message")}
    </label>
    <textarea id="contact-message" name="message" class={inputClass} rows="5" required
    ></textarea>
  </div>

  <div class="flex flex-col">
    <label class="text-sm font-medium mb-2" for="contact-resume">
      {t("form.file")}
    </label>
    <div
      class="flex flex-wrap justify-between items-center gap-2 w-full text-sm px-4 py-3 bg-gray-200 text-black dark:bg-white/10 dark:text-white rounded-lg border border-dashed border-gray-400 focus-within:border-blue-500 hover:border-blue-400 transition"
    >
      <span
        id="file-name"
        class="truncate min-w-0 flex-1"
        data-placeholder={t("form.filePlaceholder")}
      >
        {t("form.filePlaceholder")}
      </span>
      {/* min-w-0 + max-w-full: el input de archivo nativo tiene un ancho
          intrinseco que desbordaba la pagina a lo ancho en movil */}
      <input
        id="contact-resume"
        type="file"
        name="resume"
        class="text-sm min-w-0 max-w-full file:mr-2 file:rounded file:border-0 file:bg-blue-500 file:px-3 file:py-1 file:text-white file:cursor-pointer"
      />
    </div>
  </div>

  <button
    type="submit"
    class="mt-4 bg-blue-600 text-white font-bold py-2 rounded-lg hover:bg-blue-500 transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
  >
    {t("form.submit")}
  </button>
</form>

<script>
  // el nombre del archivo elegido, sin `onchange` inline en el HTML
  const fileInput = document.getElementById("contact-resume");
  const fileName = document.getElementById("file-name");

  fileInput?.addEventListener("change", (event) => {
    const files = (event.target as HTMLInputElement).files;
    if (fileName) {
      fileName.textContent =
        files?.[0]?.name ?? fileName.dataset.placeholder ?? "";
    }
  });
</script>
