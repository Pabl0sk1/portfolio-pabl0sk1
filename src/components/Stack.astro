---
import TechBubble from "./TechBubble.astro";
import HtmlIcon from "./icons/Html.astro";
import JavascriptIcon from "./icons/Javascript.astro";
import CssIcon from "./icons/Css.astro";
import ReactIcon from "./icons/React.astro";
import JavaIcon from "./icons/Java.astro";
import SpringbootIcon from "./icons/Springboot.astro";
import BootstrapIcon from "./icons/Bootstrap.astro";
import NodeIcon from "./icons/Node.astro";
import PostgresqlIcon from "./icons/Postgresql.astro";
import MysqlIcon from "./icons/Mysql.astro";
import GitIcon from "./icons/Git.astro";
import GithubIcon from "./icons/GitHub.astro";
import N8nIcon from "./icons/n8n.astro";
import PhpIcon from "./icons/Php.astro";
import DockerIcon from "./icons/Docker.astro";
import FirestoreIcon from "./icons/Firestore.astro";
import PostmanIcon from "./icons/Postman.astro";
import TailwindIcon from "./icons/Tailwind.astro";
import AstroBuildIcon from "./icons/AstroBuild.astro";
import TypescriptIcon from "./icons/Typescript.astro";
import ViteIcon from "./icons/Vite.astro";
import AngularIcon from "./icons/Angular.astro";
import LaravelIcon from "./icons/Laravel.astro";
import NextIcon from "./icons/Next.astro";
import NetlifyIcon from "./icons/Netlify.astro";
import VscodeIcon from "./icons/Vscode.astro";
import EclipseIcon from "./icons/Eclipse.astro";
import BashIcon from "./icons/Bash.astro";
import PowershellIcon from "./icons/Powershell.astro";
import HostingerIcon from "./icons/Hostinger.astro";
import DbeaverIcon from "./icons/Dbeaver.astro";
import ClickupIcon from "./icons/Clickup.astro";
import PythonIcon from "./icons/Python.astro";
import FastApiIcon from "./icons/FastApi.astro";
import ClaudeIcon from "./icons/Claude.astro";
import ChatGptIcon from "./icons/ChatGpt.astro";
import GeminiIcon from "./icons/Gemini.astro";
import DeepSeekIcon from "./icons/DeepSeek.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const CATEGORIES = [
  {
    title: t("stack.backend"),
    color: "text-green-600 dark:text-green-400",
    items: [
      { label: "Java", icon: JavaIcon, link: "https://www.java.com/es/" },
      {
        label: "Spring Boot",
        icon: SpringbootIcon,
        link: "https://spring.io/projects/spring-boot",
      },
      { label: "Python", icon: PythonIcon, link: "https://www.python.org/" },
      {
        label: "FastAPI",
        icon: FastApiIcon,
        link: "https://fastapi.tiangolo.com/",
      },
      { label: "PHP", icon: PhpIcon, link: "https://www.php.net/" },
      { label: "Laravel", icon: LaravelIcon, link: "https://laravel.com/" },
      { label: "Node.js", icon: NodeIcon, link: "https://nodejs.org/es" },
    ],
  },
  {
    title: t("stack.frontend"),
    color: "text-blue-600 dark:text-blue-400",
    items: [
      {
        label: "HTML",
        icon: HtmlIcon,
        link: "https://developer.mozilla.org/es/docs/Web/HTML",
      },
      {
        label: "CSS",
        icon: CssIcon,
        link: "https://developer.mozilla.org/es/docs/Web/CSS",
      },
      {
        label: "JavaScript",
        icon: JavascriptIcon,
        link: "https://developer.mozilla.org/es/docs/Web/JavaScript",
      },
      {
        label: "TypeScript",
        icon: TypescriptIcon,
        link: "https://www.typescriptlang.org/",
      },
      { label: "React", icon: ReactIcon, link: "https://es.react.dev/" },
      { label: "Angular", icon: AngularIcon, link: "https://angular.dev/" },
      { label: "Next.js", icon: NextIcon, link: "https://nextjs.org/" },
      { label: "Tailwind", icon: TailwindIcon, link: "https://tailwindcss.com/" },
      {
        label: "Bootstrap",
        icon: BootstrapIcon,
        link: "https://getbootstrap.com/",
      },
    ],
  },
  {
    title: t("stack.databases"),
    color: "text-yellow-600 dark:text-yellow-400",
    items: [
      {
        label: "PostgreSQL",
        icon: PostgresqlIcon,
        link: "https://www.postgresql.org/",
      },
      { label: "MySQL", icon: MysqlIcon, link: "https://www.mysql.com/" },
      {
        label: "Firebase",
        icon: FirestoreIcon,
        link: "https://firebase.google.com/",
      },
    ],
  },
  {
    title: t("stack.devops"),
    color: "text-purple-600 dark:text-purple-400",
    items: [
      { label: "Docker", icon: DockerIcon, link: "https://www.docker.com/" },
      { label: "Git", icon: GitIcon, link: "https://git-scm.com/" },
      { label: "GitHub", icon: GithubIcon, link: "https://github.com/" },
      { label: "Netlify", icon: NetlifyIcon, link: "https://www.netlify.com/" },
      {
        label: "Hostinger",
        icon: HostingerIcon,
        link: "https://www.hostinger.com/",
      },
      { label: "n8n", icon: N8nIcon, link: "https://n8n.io/" },
    ],
  },
  {
    title: t("stack.ai"),
    color: "text-rose-600 dark:text-rose-400",
    items: [
      { label: "Claude", icon: ClaudeIcon, link: "https://claude.ai/" },
      { label: "ChatGPT", icon: ChatGptIcon, link: "https://chatgpt.com/" },
      { label: "Gemini", icon: GeminiIcon, link: "https://gemini.google.com/" },
      { label: "DeepSeek", icon: DeepSeekIcon, link: "https://www.deepseek.com/" },
    ],
  },
  {
    title: t("stack.tools"),
    color: "text-gray-600 dark:text-gray-400",
    items: [
      { label: "Postman", icon: PostmanIcon, link: "https://www.postman.com/" },
      {
        label: "VS Code",
        icon: VscodeIcon,
        link: "https://code.visualstudio.com/",
      },
      { label: "Eclipse", icon: EclipseIcon, link: "https://www.eclipse.org/" },
      { label: "DBeaver", icon: DbeaverIcon, link: "https://dbeaver.io/" },
      { label: "ClickUp", icon: ClickupIcon, link: "https://clickup.com/" },
      { label: "Vite", icon: ViteIcon, link: "https://vite.dev/" },
      { label: "Astro", icon: AstroBuildIcon, link: "https://astro.build/" },
      {
        label: "Bash",
        icon: BashIcon,
        link: "https://www.gnu.org/software/bash/",
      },
      { label: "PowerShell", icon: PowershellIcon, link: "https://aka.ms/powershell" },
    ],
  },
];
---

<div class="max-w-5xl mx-auto mt-10 rounded-xl overflow-hidden space-y-4">
  {
    CATEGORIES.map(({ title, color, items }) => (
      <div class="bg-black/5 dark:bg-white/5 px-4 py-5 rounded-xl hover:bg-black/10 dark:hover:bg-white/10 transition border-b border-black/10 dark:border-white/10">
        <h3 class={`${color} font-semibold mb-3`}>{title}</h3>
        <div class="flex flex-wrap gap-3">
          {items.map(({ label, icon, link }) => (
            <TechBubble Icon={icon} label={label} link={link} visitLabel={t("stack.visit")} />
          ))}
        </div>
      </div>
    ))
  }
</div>
