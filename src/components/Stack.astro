---
import TechBubble from "./TechBubble.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { TECH, TIER_ORDER, type Tier } from "../data/tech";
import { contarPorTech, esTransversal } from "../data/projects";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cuenta = contarPorTech();

// Agrupado por nivel real y no por tipo, a proposito: asi no se da a entender
// que algo se domina mas de lo que es cierto.
const GRUPOS: {
  tier: Tier;
  title: string;
  note: string;
  color: string;
  accent: string;
}[] = [
  {
    tier: "main",
    title: t("stack.main"),
    note: t("stack.mainNote"),
    color: "text-emerald-600 dark:text-emerald-400",
    accent: "ring-emerald-500/30 bg-emerald-500/5",
  },
  {
    tier: "also",
    title: t("stack.also"),
    note: t("stack.alsoNote"),
    color: "text-blue-600 dark:text-blue-400",
    accent: "ring-blue-500/25 bg-blue-500/5",
  },
  {
    tier: "learning",
    title: t("stack.learning"),
    note: t("stack.learningNote"),
    color: "text-amber-600 dark:text-amber-400",
    accent: "ring-amber-500/20 bg-amber-500/5",
  },
  {
    tier: "tool",
    title: t("stack.tools"),
    note: t("stack.toolsNote"),
    color: "text-purple-600 dark:text-purple-400",
    accent: "ring-black/10 dark:ring-white/10",
  },
  {
    tier: "ai",
    title: t("stack.ai"),
    note: t("stack.aiNote"),
    color: "text-rose-600 dark:text-rose-400",
    accent: "ring-black/10 dark:ring-white/10",
  },
];
---

<div class="max-w-5xl mx-auto mt-10 space-y-4">
  <p class="text-sm text-gray-600 dark:text-gray-400">
    {t("stack.hint")}
  </p>

  {
    GRUPOS.map(({ tier, title, note, color, accent }) => (
      <div
        class={`px-4 py-5 rounded-xl ring-1 transition hover:bg-black/5 dark:hover:bg-white/5 ${accent}`}
      >
        <h3 class={`${color} font-semibold`}>{title}</h3>
        <p class="text-xs text-gray-600 dark:text-gray-400 mb-3 mt-0.5">{note}</p>
        <div class="flex flex-wrap gap-3">
          {TIER_ORDER[tier].map((key) => (
            <TechBubble
              tech={key}
              label={TECH[key].label}
              link={TECH[key].link}
              visitLabel={t("stack.visit")}
              usos={cuenta[key] ?? 0}
              transversal={esTransversal(key)}
              filterLabel={t("stack.filterLabel")}
              transversalLabel={t("stack.transversalLabel")}
              projectsWord={
                (cuenta[key] ?? 0) === 1 ? t("stack.project") : t("stack.projects")
              }
            />
          ))}
        </div>
      </div>
    ))
  }
</div>
