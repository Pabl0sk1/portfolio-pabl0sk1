---
import "@fontsource-variable/onest";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE_URL,
  OG_IMAGE,
  FULL_NAME,
  JOB_TITLE,
  EMAIL,
  LINKEDIN_URL,
  GITHUB_URL,
} from "../consts";
import { LANGUAGES, type Lang } from "../i18n/ui";
import {
  getLangFromUrl,
  pathForLang,
  LOCALE_TAG,
  HREFLANG,
} from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  /** Ruta sin prefijo de idioma. Ej: "/" o "/thanks" */
  path?: string;
  /** Evita que buscadores indexen paginas sin valor SEO (gracias, 404) */
  noindex?: boolean;
}

const { description, title, path, noindex = false } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);

// ruta "neutra" (sin idioma) para poder generar las alternativas
const rutaBase =
  path ?? (Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/");

const canonical = new URL(pathForLang(rutaBase, lang), SITE_URL).href;
const ogImage = new URL(OG_IMAGE, SITE_URL).href;

// hreflang reciprocos: cada version apunta a todas, incluida a si misma
const alternates = (Object.keys(LANGUAGES) as Lang[]).map((code) => ({
  hreflang: HREFLANG[code],
  href: new URL(pathForLang(rutaBase, code), SITE_URL).href,
}));

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: FULL_NAME,
  jobTitle: JOB_TITLE,
  email: `mailto:${EMAIL}`,
  url: SITE_URL,
  image: ogImage,
  sameAs: [LINKEDIN_URL, GITHUB_URL],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Hernandarias",
    addressRegion: "Alto Paraná",
    addressCountry: "PY",
  },
  knowsAbout: [
    "Python",
    "FastAPI",
    "React",
    "PostgreSQL",
    "Docker",
    "APIs REST",
    "PHP",
    "Laravel",
    "Java",
    "Spring Boot",
    "Automatización de procesos",
    "Sistemas ERP",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={FULL_NAME} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pathForLang(rutaBase, "es"), SITE_URL).href}
    />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph: como se ve el enlace en LinkedIn, WhatsApp, Slack... -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={FULL_NAME} />
    <meta property="og:locale" content={LOCALE_TAG[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${FULL_NAME} - ${JOB_TITLE}`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    {/* Bloqueante y en el head a proposito: aplica el tema ANTES del primer
        pintado. Si esto se difiere, la pagina parpadea en claro antes de
        pasar a oscuro. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var isDark =
            saved === "dark" ||
            (saved === null &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          var root = document.documentElement;
          root.classList.toggle("dark", isDark);
          root.style.colorScheme = isDark ? "dark" : "light";
        } catch (e) {
          /* localStorage bloqueado (modo privado): se usa el tema claro */
        }
      })();
    </script>
  </head>
  <body class="relative text-black dark:text-white bg-blue-50 dark:bg-gray-950">
    <div
      class="fixed inset-0 z-[-2] w-full bg-blue-100 dark:bg-gray-950
      bg-[radial-gradient(ellipse_90%_90%_at_90%_-20%,rgba(217,216,255,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    {/* El scroll vive aqui y no en el <body> a proposito: asi la barra
        pertenece a este contenedor, que arranca justo debajo del header.
        La barra del documento la pinta el navegador a lo alto completo y no
        hay CSS que la recorte. */}
    <div id="scroll-area">
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    /* alto del header fijo. Son valores de partida para evitar un salto al
       cargar; el script del header los corrige con la medida real. */
    --header-h: 46px;
  }

  @media (min-width: 640px) {
    :root {
      --header-h: 52px;
    }
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    height: 100%;
  }

  /* el documento no scrollea: lo hace #scroll-area */
  body {
    height: 100%;
    overflow: hidden;
  }

  #scroll-area {
    position: fixed;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    /* el hueco inicial lo da el padding, no la posicion: asi el contenido
       sigue pasando por detras del header y el efecto cristal se mantiene */
    padding-top: var(--header-h);
    scroll-behavior: smooth;
    overscroll-behavior: none;
    display: flex;
    flex-direction: column;
  }

  /* --- Scrollbar propio ------------------------------------------------ */
  /* Firefox: solo admite ancho y color, sin poder recortar la pista.
     Va aislado con @supports a proposito: desde Chrome 121, declarar
     `scrollbar-width` desactiva por completo las reglas ::-webkit-scrollbar,
     y perderiamos el estilo y el recorte bajo el header. */
  @supports not selector(::-webkit-scrollbar) {
    html {
      scrollbar-width: thin;
      scrollbar-color: rgb(59 130 246 / 0.55) rgb(15 23 42 / 0.09);
    }

    html.dark {
      scrollbar-color: rgb(96 165 250 / 0.5) rgb(255 255 255 / 0.08);
    }
  }

  /* Chrome, Edge, Safari */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: rgb(15 23 42 / 0.09);
  }

  html.dark ::-webkit-scrollbar-track {
    background: rgb(255 255 255 / 0.08);
  }

  /* Aqui si funciona: es la barra de un elemento, no la del documento.
     Chrome ignora este margen en la barra de la ventana pero lo respeta en
     un contenedor con overflow propio. */
  #scroll-area::-webkit-scrollbar-track {
    margin-top: var(--header-h);
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(
      180deg,
      rgb(59 130 246 / 0.75),
      rgb(79 70 229 / 0.75)
    );
    cursor: pointer;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, rgb(37 99 235), rgb(67 56 202));
    cursor: pointer;
  }

  html.dark ::-webkit-scrollbar-thumb {
    background: linear-gradient(
      180deg,
      rgb(96 165 250 / 0.7),
      rgb(129 140 248 / 0.7)
    );
  }

  html.dark ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, rgb(96 165 250), rgb(129 140 248));
  }

  ::-webkit-scrollbar-corner {
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-area {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
